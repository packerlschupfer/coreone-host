[Unit]
Description=Daily archive of klippy/moonraker rotated logs

[Timer]
# klippy rolls over at midnight; run after that so the previous day's file exists
# as klippy.log.<date> and is closed. Persistent=true catches up a missed run after
# the Pi has been off -- the whole point is not to lose days.
OnCalendar=*-*-* 01:30:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
