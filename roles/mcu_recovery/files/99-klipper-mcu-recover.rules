# Auto-recovery for a separately-powered host: when either Klipper MCU serial
# re-enumerates (printer power-cycled, OR a mid-session USB re-enumeration), start
# the auto-recover oneshot, which FIRMWARE_RESTARTs klippy if it is stuck and
# escalates to a klipper service restart if that does not clear it.
#
# Both MCUs are matched so recovery also fires if only the H503 re-enumerates; the
# script's 45s debounce coalesces the double-fire when both come back together.
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_MODEL}=="stm32f427xx", TAG+="systemd", ENV{SYSTEMD_WANTS}="klipper-mcu-recover.service"
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_MODEL}=="stm32h503xx", TAG+="systemd", ENV{SYSTEMD_WANTS}="klipper-mcu-recover.service"
